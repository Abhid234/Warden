{
  "manifest_version": 3,
  "name": "Warden — Feed Sensitivity Control",
  "version": "0.1.3",
  "description": "Filters sensitive images, topic matches, and toxic comments on Instagram and Reddit.",
  "browser_specific_settings": {
    "gecko": {
      "id": "warden@example.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.reddit.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": [
        "lib/storage.js",
        "lib/classifier.js",
        "content-scripts/filter-engine.js",
        "content-scripts/instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": [
        "lib/storage.js",
        "lib/classifier.js",
        "content-scripts/filter-engine.js",
        "content-scripts/reddit.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
